# API 配置
VITE_API_BASE_URL=/api

# 阿里云 OSS 配置（未来使用）
# OSS 访问域名（如：oss-cn-hangzhou.aliyuncs.com）
VITE_OSS_ENDPOINT=
# OSS Bucket 名称
VITE_OSS_BUCKET=
# OSS CDN 域名（可选，如果有配置 CDN 加速）
VITE_OSS_CDN_DOMAIN=

# 示例：
# VITE_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# VITE_OSS_BUCKET=my-blog-assets
# VITE_OSS_CDN_DOMAIN=cdn.myblog.com
